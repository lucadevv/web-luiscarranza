# ─────────────────────────────────────────
# luiscarranza.com — Environment Variables
# Copy this file to `.env.local` (gitignored) and fill in real values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────

# ─── Resend (transactional email + audience) ─────────
# Get an API key with Full Access at https://resend.com/api-keys
# Verify your domain at https://resend.com/domains before sending from a custom address
RESEND_API_KEY=
CONTACT_FROM_EMAIL=no-reply@luiscarranza.com
CONTACT_TO_EMAIL=contact@luiscarranza.com

# Audience ID for the newsletter — get at https://resend.com/audiences
RESEND_AUDIENCE_ID=

# ─── Firebase Analytics ──────────────────────────────
# From https://console.firebase.google.com → Project Settings → General → Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
