# Dependencies (re-installed in image)
node_modules
.pnp
.pnp.js

# Build artifacts (regenerated)
.next
out
build
dist

# Version control
.git
.gitignore
.gitattributes

# Developer tooling
.agents
.claude
.vscode
.idea
skills-lock.json

# Internal scripts (not part of the product)
_scripts

# Design source (local reference only)
.design-source

# Docker meta (don't include compose files in build context)
Dockerfile*
docker-compose*.yml

# Markdown docs (except README which we want in the image for reference)
CHANGELOG.md
CONTRIBUTING.md

# Local env (production gets vars via env_file or --env-file)
.env
.env*.local
!.env.example

# Test artifacts
coverage
*.tsbuildinfo

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.pem
.vercel
